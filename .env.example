# Copier vers .env.local (jamais committé) et renseigner.

# URL publique du site (sitemap, robots, Open Graph)
NEXT_PUBLIC_APP_LINK=https://example.com

# Affiche le sélecteur de couleur d'accent (propriétaire seulement) : true en local / préproduction
NEXT_PUBLIC_COLOR_SWITCHER=false
# Affiche le choix du modèle de mise en page (propriétaire seulement). Rend la page d'accueil dynamique : à réserver au local / à la préproduction
NEXT_PUBLIC_TEMPLATE_SWITCHER=false

# Formulaire de contact (envoi via Resend : https://resend.com, clé gratuite)
RESEND_API_KEY=
# Adresse qui reçoit les messages (par défaut : l'e-mail du site)
CONTACT_TO_EMAIL=
# Expéditeur affiché. Sans domaine vérifié chez Resend : "Portfolio <onboarding@resend.dev>"
CONTACT_FROM_EMAIL=

# (facultatif) autre point d'entrée de l'API d'envoi
RESEND_API_URL=
